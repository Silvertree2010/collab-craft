# CollabCraft configuration. Copy to .env and fill in.
#
# Nothing here has a default that would work by accident. The service refuses
# to start without a secret, and warns loudly rather than pretending when an
# identity provider or a cloud provider is missing.

# ---- the shared secret ------------------------------------------------------
# Signs the join tokens the relay verifies. Both halves live in this one
# process, so this is the only place it appears.
#
# Generate one and keep it out of version control:
#   LC_ALL=C tr -dc 'A-Za-z0-9' < /dev/urandom | head -c 48
#
# Rotating it invalidates every outstanding token, which is the intended way to
# revoke them all at once.
COLLABCRAFT_SECRET=

# ---- where this service is reached ------------------------------------------
# The public address, used for the OIDC redirect and handed to clients as the
# relay address. Not the bind address: a client elsewhere has to reach it.
COLLABCRAFT_PUBLIC_URL=https://collabcraft.example.com

# What the container publishes on the host. Keep it on the loopback when a
# reverse proxy terminates TLS in front, which is the usual arrangement.
COLLABCRAFT_LISTEN=127.0.0.1:9444

# ---- identity ---------------------------------------------------------------
# Any OIDC provider. Tested against Authentik and Keycloak.
#
# The issuer is the one whose /.well-known/openid-configuration resolves. For
# Authentik that includes the application slug.
#
# Register a confidential client with this redirect URI:
#   ${COLLABCRAFT_PUBLIC_URL}/auth/callback
# and the scopes openid, profile, email, groups. Entitlement is decided from
# group membership, so without the groups scope every user looks ungrouped.
COLLABCRAFT_OIDC_ISSUER=https://id.example.com/application/o/collabcraft/
COLLABCRAFT_OIDC_CLIENT_ID=
COLLABCRAFT_OIDC_CLIENT_SECRET=
COLLABCRAFT_OIDC_REDIRECT_URI=https://collabcraft.example.com/auth/callback

# ---- the cloud provider ------------------------------------------------------
# Where documents live. Nextcloud today; the contracts in craft-cloud are not
# specific to it, and a second provider is an implementation of six traits.
COLLABCRAFT_PROVIDER_URL=https://cloud.example.com

# ---- the bus -----------------------------------------------------------------
# Any Redis-compatible server. Holds the per-document sequence, the scope locks
# and the sessions, all with expiry.
#
# It must not evict. The sequence counters are not a cache, and losing one
# silently reorders every edit in that document.
COLLABCRAFT_VALKEY_URL=redis://valkey:6379/6

# ---- entitlement -------------------------------------------------------------
# Which apps a user may open. The default applies to everyone who signs in.
# Add COLLABCRAFT_APPS_<GROUP> to grant more to a group from the identity
# provider, upper-cased, for example COLLABCRAFT_APPS_EDITORS.
COLLABCRAFT_APPS_DEFAULT=gridcraft,wordcraft,deckcraft

# ---- the browser builds ------------------------------------------------------
# A directory of per-app WebAssembly builds, one directory per app, served
# behind the same permission check. Leave COLLABCRAFT_WEB_DIR pointing at an
# empty directory to run as an API and relay only.
#
# Serve them precompressed: put foo.wasm.br beside foo.wasm and the service
# sends it with the right Content-Encoding. Brotli at a high level costs
# minutes per bundle, which is unaffordable per request and free once.
COLLABCRAFT_WEB_DIR=./web

# ---- certificates ------------------------------------------------------------
# Only needed where the identity provider or the cloud provider is behind a CA
# the base image does not ship, which is common on an internal deployment.
# Mount a bundle carrying the public roots alongside your own, and point this
# at it. Replacing the system bundle with only your CA breaks every public call.
# COLLABCRAFT_CA_BUNDLE=/etc/ssl/collabcraft/ca-bundle.pem

# ---- image -------------------------------------------------------------------
# COLLABCRAFT_IMAGE=ghcr.io/wdunn001/collabcraft:latest
